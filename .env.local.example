# Másold `.env.local` néven, és töltsd ki. Élesben ugyanezek kellenek a
# Vercelbe is: Settings → Environment Variables.

# Resend API kulcs. Enélkül fejlesztői módban az e-mail csak a konzolra kerül,
# élesben (production) az űrlap 503-mal hibát jelez.
RESEND_API_KEY=

# Címzett. Ha üresen hagyod, a src/lib/site.ts-beli CONTACT.email lesz
# (holidayvendeghaz2024@gmail.com).
CONTACT_RECIPIENT=

# Feladó. A domainnek IGAZOLTNAK kell lennie a Resend fiókban, különben a
# küldés elutasításra kerül. Alapértelmezés:
# "Holiday Vendégház <urlap@holidayvendeghaz.hu>"
CONTACT_FROM=


# ─── FOGLALÁSI RENDSZER (Google Naptár) ──────────────────────────────────────

# A service account kulcs TELJES JSON-ja, EGY sorban. A fájl itt található:
#   Prometheus Digital\Infos\holiday-vendeghaz-booking-*.json
# Vercelbe a fájl teljes tartalmát másold be egy env változóként.
GOOGLE_SERVICE_ACCOUNT_JSON=

# A „Foglalások” naptár azonosítója. Ellenőrzés: node check-calendar.mjs <kulcs>
GOOGLE_CALENDAR_ID=e7df7b25440b2ba4b681538948ed4b13b9e1ae49767c28d4c0e3268426e0ca88@group.calendar.google.com

# A tulajdonosnak küldött jóváhagyó/elutasító linkek aláírásához. Élesben
# KÖTELEZŐ – legyen hosszú, véletlenszerű. Generálás:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOOKING_SECRET=
